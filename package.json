{
  "name": "atoms-like-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:serve": "node scripts/testing/e2e-server.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:http": "playwright test tests/http",
    "test:public:long": "node scripts/testing/cloud-http-test.mjs --public-demo",
    "test:http:cloud": "node scripts/testing/cloud-http-test.mjs",
    "test:http:cloud:cleanup": "node scripts/testing/cloud-test-cleanup.mjs",
    "demo:start": "node scripts/demo/manage.mjs start",
    "demo:tunnel": "cloudflared tunnel --protocol http2 --no-autoupdate run --token-file \"$HOME/.cloudflared/forma-demo.token\"",
    "demo:stop": "node scripts/demo/manage.mjs stop",
    "demo:status": "node scripts/demo/manage.mjs status",
    "demo:serve": "node scripts/demo/start.mjs",
    "test:public:projects": "node scripts/testing/cloud-http-test.mjs --public-demo --grep \"project creation latency\""
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.74",
    "@base-ui/react": "^1.9.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.146",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "undici": "^7.30.1",
    "vitest": "^5.0.5"
  }
}
