# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exact public origin used by OAuth callbacks (localhost for development).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# A model endpoint compatible with the OpenAI chat-completions/tool-calling protocol.
# Include the API prefix, e.g. https://your-provider.example/v1.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional local development mode: use an existing `codex login` with ChatGPT.
# Production requires explicit personal demo mode (see README); disabled on Vercel.
# AGENT_BACKEND=codex-local
# CODEX_CLI_PATH=/absolute/path/to/codex

# Cloud + local worker deployment (server-side values; never commit real secrets).
# AGENT_BACKEND=codex-worker
# CODEX_WORKER_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# On the local worker, use .env.worker instead of .env.local; see docs/DEMO_ACCESS.md.
